{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "ChargeMotion",
    "version":  "0.1.0",
    "identifier":  "com.chargemotion.desktop",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "ChargeMotion",
                                    "width":  1000,
                                    "height":  680,
                                    "minWidth":  880,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "visible":  false
                                },
                                {
                                    "label":  "wallpaper",
                                    "title":  "ChargeMotion Wallpaper",
                                    "url":  "wallpaper.html",
                                    "width":  1920,
                                    "height":  1080,
                                    "x":  0,
                                    "y":  0,
                                    "resizable":  false,
                                    "decorations":  false,
                                    "visible":  false,
                                    "skipTaskbar":  true,
                                    "shadow":  false
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [

                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "startMenuFolder":  "ChargeMotion"
                                            }
                               }
               }
}